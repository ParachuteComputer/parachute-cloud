# Where STAGING lives: the one source for the staging Cloudflare account, its workers.dev subdomain and its
# resources. Sourced by scripts/deploy-staging.sh + scripts/staging-bootstrap.sh, parsed by scripts/staging-origins.ts
# (the smoke scripts' default origins). test-bun/staging-account.test.ts holds both wrangler.toml [env.staging]
# blocks to these values.
#
# Staging has its own account ("Parachute Staging", no production on it) since T-432. Before that it lived on the
# production account (d5d7c864…), so every staging deploy needed a production-account key. Production stays where it
# is: the TOP LEVEL of each wrangler.toml, no account_id there, CLOUDFLARE_ACCOUNT_ID from scripts/deploy-prod.sh.
#
# Plain KEY=value lines only (no quotes, no expansion): bash sources this file and staging-origins.ts reads it.

STAGING_ACCOUNT_ID=5b543fa4332a619203356ae1418af504

# The account's workers.dev subdomain: every staging URL is https://<worker>.<this>.workers.dev. Chosen once, in the
# dashboard (Workers & Pages → your subdomain) before the first deploy; staging-bootstrap.sh checks the account has it.
STAGING_WORKERS_SUBDOMAIN=parachute-staging

# The staging D1. The id is all zeros until staging-bootstrap.sh creates the database and writes its id here and into
# workers/identity/wrangler.toml [env.staging.d1_databases]; deploy-staging.sh refuses while it is the placeholder.
STAGING_D1_NAME=parachute-identity-staging
STAGING_D1_ID=00000000-0000-0000-0000-000000000000

# The staging attachment/export bucket (workers/vault/wrangler.toml [env.staging.r2_buckets]).
STAGING_R2_BUCKET=parachute-vault-staging

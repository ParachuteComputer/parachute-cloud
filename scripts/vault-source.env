# Exact parachute-vault source used by Cloud's shared @openparachute/core
# file dependency. CI and local deploys verify this commit so unrelated
# upstream work or a developer branch cannot change a build or deployment
# (cloud#45, cloud#59).
# Includes bounded content audit (vault#759); release awaits upstream integration.
# The version check gives no protection because VAULT_CORE_VERSION never moves
# — the SHA is the entire pin. core/package.json is still 0.1.0.
VAULT_CORE_VERSION="0.1.0"
VAULT_CORE_REF="ebecd3ae1b4e9ee992266441c59427c35903b125"

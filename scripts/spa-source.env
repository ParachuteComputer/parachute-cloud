# Exact app source embedded in the Cloud identity worker: the repository, the package it must be, its version and
# its commit. Bump them deliberately after the target commit has passed its own test and build gates. Deploy workflows
# fetch SPA_APP_REF from SPA_APP_REPO exactly, into a sibling checkout named after the repository; build-spa.sh
# verifies that checkout still declares SPA_APP_NAME at SPA_APP_VERSION.
#   ParachuteComputer/parachute-app  (@openparachute/app): the older hosted app, built with bun
#   ParachuteComputer/parachute      (parachute): the Parachute app's web build, built with npm; it says what it
#                                    asks of a host in dist/hosted.json (its docs/HOSTING.md)
SPA_APP_REPO="ParachuteComputer/parachute"
SPA_APP_NAME="parachute"
SPA_APP_VERSION="0.1.0"
SPA_APP_REF="67738e80d8ed73652520cf3f35a572581ff2c485"
# The older hosted app, as production ran it until this pin (the way back: put these four lines back):
#   SPA_APP_REPO="ParachuteComputer/parachute-app"  SPA_APP_NAME="@openparachute/app"
#   SPA_APP_VERSION="0.22.15-rc.11"  SPA_APP_REF="3776bc6ff1049603ed257bab5f9788953c6652a0"

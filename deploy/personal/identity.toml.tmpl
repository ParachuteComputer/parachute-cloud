# GENERATED by deploy/personal/render.sh from identity.toml.tmpl: do not edit or commit (gitignored).
# The personal door's identity worker (door/0.9, T-430). Single owner: OWNER_PUBKEY (+ ADMIN_PUBKEYS) sign in with
# NIP-98, the owner starts on OWNER_PLAN. Signups closed by config: no [[send_email]] binding, so a sign-in link or
# code only reaches the worker log. ENVIRONMENT = "production": no dev headers, no __test routes, no mock billing.
# Billing off: no Stripe secrets or prices. One cron: the nightly snapshots (04:00 UTC) into R2.
name = "@PREFIX@-identity"
main = "src/index.ts"
compatibility_date = "2025-07-01"
compatibility_flags = ["nodejs_compat"]
workers_dev = true
@IDENTITY_ROUTES@

[observability]
enabled = true
head_sampling_rate = 1

[triggers]
crons = ["0 4 * * *"]

[[d1_databases]]
binding = "DB"
database_name = "@PREFIX@-identity"
database_id = "@D1_ID@"
migrations_dir = "migrations"

[version_metadata]
binding = "CF_VERSION_METADATA"

[[durable_objects.bindings]]
name = "RATE_LIMITER"
class_name = "RateLimiterDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["RateLimiterDO"]

[[services]]
binding = "VAULT_SERVICE"
service = "@PREFIX@-vault"

[vars]
ISSUER = "@IDENTITY_ORIGIN@"
APP_ORIGIN = "@IDENTITY_ORIGIN@"
VAULT_BASE_DOMAIN = "@VAULT_HOST@"
VAULT_ORIGIN = "@VAULT_ORIGIN@"
ENVIRONMENT = "production"
BILLING_MODE = "open_beta"
OWNER_PUBKEY = "@OWNER_PUBKEY@"
ADMIN_PUBKEYS = "@ADMIN_PUBKEYS@"
OWNER_PLAN = "@OWNER_PLAN@"

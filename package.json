{
  "name": "@openparachute/cloud",
  "version": "0.0.8-rc.86",
  "private": true,
  "description": "Open Parachute PBC's Vault Cloud — one Durable Object per vault on Cloudflare, OAuth issuer + self-serve console (accounts + vault ownership).",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "src/server.ts",
  "workspaces": [
    "workers/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun test src test-bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply parachute-cloud-control --local",
    "db:migrate:remote": "wrangler d1 migrations apply parachute-cloud-control --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "stripe": "22.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.106.0"
  }
}
